#!/bin/bash
set -euo pipefail

colors="$HOME/.config/omarchy/current/theme/colors.toml"
theme="$HOME/.config/yazi/theme.toml"

get_color() {
  local key="$1"
  local fallback="$2"
  sed -n "s/^${key} = \"\\(#[0-9A-Fa-f]\\{6\\}\\)\"/\\1/p" "$colors" | head -n 1 || printf '%s\n' "$fallback"
}

accent="#b4befe"
cursor="$(get_color cursor '#f5e0dc')"
foreground="$(get_color foreground '#cdd6f4')"
background="#000000"
selection_foreground="$(get_color selection_foreground '#1e1e2e')"
selection_background="$(get_color selection_background '#f5e0dc')"
color0="$(get_color color0 '#45475a')"
color1="$(get_color color1 '#f38ba8')"
color2="$(get_color color2 '#a6e3a1')"
color3="$(get_color color3 '#f9e2af')"
color4="$(get_color color4 "$accent")"
color5="$(get_color color5 '#f5c2e7')"
color6="$(get_color color6 '#94e2d5')"
color7="$(get_color color7 "$foreground")"
color8="$(get_color color8 '#585b70')"

mkdir -p "$(dirname "$theme")"

cat > "$theme" <<EOF
"\$schema" = "https://yazi-rs.github.io/schemas/theme.json"

# Generated from Omarchy theme: ~/.config/omarchy/current/theme/colors.toml

[app]
overall = { bg = "$background" }

[mgr]
cwd             = { fg = "$accent", bold = true }
find_keyword    = { fg = "$selection_foreground", bg = "$color3", bold = true }
find_position   = { fg = "$color5" }
symlink_target  = { fg = "$color6" }
marker_copied   = { fg = "$color2", bg = "$color2" }
marker_cut      = { fg = "$color1", bg = "$color1" }
marker_marked   = { fg = "$color3", bg = "$color3" }
marker_selected = { fg = "$selection_background", bg = "$selection_background" }
count_copied    = { fg = "$color2" }
count_cut       = { fg = "$color1" }
count_selected  = { fg = "$selection_background" }
border_symbol   = "│"
border_style    = { fg = "$color0" }

[tabs]
active    = { fg = "$selection_foreground", bg = "$selection_background", bold = true }
inactive  = { fg = "$foreground", bg = "$background" }
sep_inner = { open = "", close = "" }
sep_outer = { open = "", close = "" }

[mode]
normal_main = { fg = "$selection_foreground", bg = "$selection_background", bold = true }
normal_alt  = { fg = "$accent", bg = "$background" }
select_main = { fg = "$selection_foreground", bg = "$color2", bold = true }
select_alt  = { fg = "$color2", bg = "$background" }
unset_main  = { fg = "$selection_foreground", bg = "$color1", bold = true }
unset_alt   = { fg = "$color1", bg = "$background" }

[indicator]
parent  = { fg = "$color5" }
current = { fg = "$accent", bold = true }
preview = { fg = "$color6" }
padding = { open = "", close = "" }

[status]
overall         = { fg = "$foreground", bg = "$background" }
sep_left        = { open = "", close = "" }
sep_right       = { open = "", close = "" }
perm_sep        = { fg = "$color8" }
perm_type       = { fg = "$accent" }
perm_read       = { fg = "$color3" }
perm_write      = { fg = "$color1" }
perm_exec       = { fg = "$color2" }
progress_label  = { fg = "$foreground", bold = true }
progress_normal = { fg = "$accent", bg = "$background" }
progress_error  = { fg = "$color1", bg = "$background" }

[which]
cols            = 3
mask            = { bg = "$background" }
cand            = { fg = "$color6" }
rest            = { fg = "$color8" }
desc            = { fg = "$color5" }
separator       = "  "
separator_style = { fg = "$color0" }

[confirm]
border     = { fg = "$accent" }
title      = { fg = "$accent", bold = true }
body       = { fg = "$foreground" }
list       = { fg = "$color7" }
btn_yes    = { fg = "$selection_foreground", bg = "$color2", bold = true }
btn_no     = { fg = "$selection_foreground", bg = "$color1", bold = true }
btn_labels = [ "  yes  ", "  no  " ]

[spot]
border   = { fg = "$accent" }
title    = { fg = "$accent", bold = true }
tbl_col  = { fg = "$color6" }
tbl_cell = { fg = "$foreground" }

[notify]
title_info  = { fg = "$accent" }
title_warn  = { fg = "$color3" }
title_error = { fg = "$color1" }
icon_info   = ""
icon_warn   = ""
icon_error  = ""

[pick]
border   = { fg = "$accent" }
active   = { fg = "$selection_foreground", bg = "$selection_background", bold = true }
inactive = { fg = "$foreground" }

[input]
border   = { fg = "$accent" }
title    = { fg = "$accent", bold = true }
value    = { fg = "$foreground" }
selected = { fg = "$selection_foreground", bg = "$selection_background" }

[cmp]
border       = { fg = "$accent" }
active       = { fg = "$selection_foreground", bg = "$selection_background", bold = true }
inactive     = { fg = "$foreground" }
icon_file    = ""
icon_folder  = ""
icon_command = ""

[tasks]
border  = { fg = "$accent" }
title   = { fg = "$accent", bold = true }
hovered = { fg = "$selection_foreground", bg = "$selection_background", bold = true }

[help]
on      = { fg = "$accent", bold = true }
run     = { fg = "$color2" }
desc    = { fg = "$foreground" }
hovered = { fg = "$selection_foreground", bg = "$selection_background", bold = true }
footer  = { fg = "$color8" }

[filetype]
rules = [
  { mime = "image/*", fg = "$color3" },
  { mime = "{audio,video}/*", fg = "$color5" },
  { mime = "application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "$color1" },
  { mime = "application/{json,ndjson}", fg = "$color2" },
  { mime = "text/*", fg = "$foreground" },
  { url = "*/", fg = "$accent", bold = true },
  { url = "*", is = "orphan", fg = "$color1" },
]

[icon]
prepend_dirs = [
  { name = "Desktop", text = "", fg = "$accent" },
  { name = "Documents", text = "󰈙", fg = "$color6" },
  { name = "Downloads", text = "", fg = "$color2" },
  { name = "Music", text = "", fg = "$color5" },
  { name = "Pictures", text = "", fg = "$color3" },
  { name = "Videos", text = "", fg = "$color1" },
  { name = ".config", text = "", fg = "$accent" },
]

prepend_files = [
  { name = "Dockerfile", text = "󰡨", fg = "$accent" },
  { name = "Makefile", text = "", fg = "$color3" },
  { name = "README.md", text = "󰂺", fg = "$accent" },
]

prepend_exts = [
  { name = "lua", text = "", fg = "$accent" },
  { name = "rs", text = "", fg = "$color1" },
  { name = "go", text = "", fg = "$color6" },
  { name = "js", text = "", fg = "$color3" },
  { name = "ts", text = "", fg = "$accent" },
  { name = "jsx", text = "", fg = "$accent" },
  { name = "tsx", text = "", fg = "$accent" },
  { name = "json", text = "", fg = "$color2" },
  { name = "toml", text = "", fg = "$color5" },
  { name = "yaml", text = "", fg = "$color5" },
  { name = "yml", text = "", fg = "$color5" },
  { name = "md", text = "", fg = "$foreground" },
  { name = "sh", text = "", fg = "$color2" },
  { name = "png", text = "", fg = "$color3" },
  { name = "jpg", text = "", fg = "$color3" },
  { name = "jpeg", text = "", fg = "$color3" },
  { name = "svg", text = "󰜡", fg = "$color3" },
  { name = "mp3", text = "", fg = "$color5" },
  { name = "mp4", text = "", fg = "$color1" },
  { name = "zip", text = "", fg = "$color1" },
]

prepend_conds = [
  { if = "hidden & dir", text = "󱞞", fg = "$color8" },
  { if = "dir", text = "", fg = "$accent" },
  { if = "hidden", text = "󰘓", fg = "$color8" },
]
EOF
